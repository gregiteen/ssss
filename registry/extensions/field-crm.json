{
  "$schema": "https://ssss.dev/registry/v1",
  "registry": "dabber",
  "extends": "core",
  "version": "1.9.0",
  "spec_version": "0.9",
  "description": "Field CRM extension. Contacts, notes, companies, sales, products, settings, emails, calendar events, files and Signed, gi. envelopes are tenant-private Markdown records. A company document groups every location and contact of one retailer and records which rep claimed it. Google connection metadata is resource-bound; no secret values are stored in the vault.",
  "document_primitives": {
    "account_workflow": {
      "family": "crm",
      "canonical_path": "workflows/accounts/<workflow_id>.md",
      "append_only": false,
      "portability": "tenant_private",
      "required_fields": [
        "type",
        "workflow_id",
        "name",
        "contact_id",
        "owner",
        "command",
        "method",
        "path",
        "arguments",
        "status",
        "approved_at",
        "next_run_at",
        "triggers",
        "approval_signature"
      ],
      "patterns": {
        "workflow_id": "^workflow-[a-f0-9]{32}$",
        "contact_id": "^contact-[a-z0-9-]{8,64}$"
      },
      "enums": {
        "status": [
          "queued",
          "scheduled",
          "running",
          "succeeded",
          "failed",
          "needs_review",
          "canceled"
        ]
      }
    },
    "contact": {
      "family": "crm",
      "canonical_path": "contacts/<company_slug>/<contact_id>.md",
      "append_only": false,
      "portability": "tenant_private",
      "required_fields": [
        "type",
        "contact_id",
        "name",
        "company",
        "contact_kind",
        "lifecycle",
        "owner",
        "created_at",
        "updated_at"
      ],
      "enums": {
        "contact_kind": [
          "retailer",
          "distributor",
          "budtender",
          "event_partner",
          "creator",
          "other"
        ],
        "lifecycle": [
          "prospect",
          "contacted",
          "qualified",
          "active_account",
          "nurture",
          "closed_lost"
        ],
        "preferred_channel": [
          "email",
          "text"
        ]
      },
      "patterns": {
        "contact_id": "^contact-[a-z0-9-]{8,64}$"
      }
    },
    "contact_note": {
      "family": "crm",
      "canonical_path": "contacts/<company_slug>/<contact_id>/NOTES.md",
      "append_only": true,
      "portability": "tenant_private",
      "required_fields": [
        "type",
        "contact_id",
        "note_stream_id",
        "created_at"
      ],
      "patterns": {
        "contact_id": "^contact-[a-z0-9-]{8,64}$",
        "note_stream_id": "^notes-[a-z0-9-]{8,64}$"
      }
    },
    "company": {
      "family": "crm",
      "canonical_path": "contacts/<company_slug>/COMPANY.md",
      "append_only": false,
      "portability": "tenant_private",
      "required_fields": [
        "type",
        "company_id",
        "company",
        "company_slug",
        "owner",
        "location_count",
        "contact_count",
        "created_at",
        "updated_at"
      ],
      "patterns": {
        "company_id": "^company-[a-z0-9-]{1,120}$",
        "company_slug": "^[a-z0-9-]{1,120}$"
      }
    },
    "sale": {
      "family": "crm",
      "canonical_path": "sales/<sale_id>.md",
      "append_only": false,
      "portability": "tenant_private",
      "required_fields": [
        "type",
        "sale_id",
        "contact_id",
        "name",
        "stage",
        "amount",
        "currency",
        "owner",
        "created_at",
        "updated_at"
      ],
      "enums": {
        "stage": [
          "discovery",
          "sample_sent",
          "proposal",
          "negotiation",
          "won",
          "lost"
        ],
        "currency": [
          "USD"
        ]
      },
      "patterns": {
        "sale_id": "^sale-[a-z0-9-]{8,64}$",
        "contact_id": "^contact-[a-z0-9-]{8,64}$"
      }
    },
    "integration_connection": {
      "family": "resource",
      "canonical_path": "integrations/<provider>.md",
      "append_only": false,
      "portability": "resource_bound",
      "resource": {
        "kind": "api_connection",
        "binds": [
          "provider"
        ],
        "provision_relation": "connects_to"
      },
      "required_fields": [
        "type",
        "provider",
        "status",
        "capabilities",
        "verified_at"
      ],
      "enums": {
        "status": [
          "not_connected",
          "configured",
          "verified",
          "error"
        ]
      }
    },
    "product": {
      "family": "crm",
      "canonical_path": "products/<sku>.md",
      "append_only": false,
      "portability": "tenant_private",
      "required_fields": [
        "type",
        "sku",
        "name",
        "category",
        "wholesale_price",
        "msrp",
        "map_price",
        "margin_percent",
        "created_at",
        "updated_at"
      ]
    },
    "email": {
      "family": "crm",
      "canonical_path": "emails/<id>.md",
      "append_only": false,
      "portability": "tenant_private",
      "required_fields": [
        "type",
        "id",
        "from",
        "to",
        "subject",
        "date",
        "folder"
      ]
    },
    "email_open": {
      "family": "crm",
      "canonical_path": "emails/opens/<message_id>.md",
      "append_only": false,
      "portability": "tenant_private",
      "required_fields": [
        "type",
        "message_id",
        "recipient",
        "subject",
        "sender",
        "first_opened_at",
        "last_opened_at",
        "open_count"
      ],
      "description": "Tracking-pixel opens for an email sent from the platform, recorded by the public cloud instance and synced to every peer."
    },
    "email_sms_reminder": {
      "family": "crm",
      "canonical_path": "emails/sms-reminders/<account_id>/<message_id>.md",
      "append_only": false,
      "portability": "tenant_private",
      "required_fields": [
        "type",
        "account_id",
        "message_id",
        "received_at",
        "sms_sent_at",
        "baseline"
      ],
      "description": "One SMS alert receipt per Gmail message plus a mailbox baseline marker."
    },
    "calendar_event": {
      "family": "crm",
      "canonical_path": "calendar/<id>.md",
      "append_only": false,
      "portability": "tenant_private",
      "required_fields": [
        "type",
        "id",
        "summary",
        "start",
        "status"
      ]
    },
    "file_asset": {
      "family": "crm",
      "canonical_path": "files/meta/<id>.md",
      "append_only": false,
      "portability": "tenant_private",
      "required_fields": [
        "type",
        "id",
        "filename",
        "title",
        "size",
        "mimetype",
        "category",
        "visibility",
        "uploaded_at"
      ],
      "description": "Catalogue record for a collateral file in vault/files/<filename>; owner + visibility (team|private) + shared_with control who can see it. Binaries sync alongside these records."
    },
    "signed_gi_envelope": {
      "family": "crm",
      "canonical_path": "signedgi/<envelope_id>.md",
      "append_only": false,
      "portability": "tenant_private",
      "required_fields": [
        "type",
        "envelope_id",
        "document_id",
        "title",
        "recipient_name",
        "recipient_email",
        "status",
        "signing_url",
        "created_at"
      ],
      "description": "A Documenso (Signed, gi.) document sent for signature; status mirrors Documenso (pending_signature|signed|rejected|draft) and is never set by hand."
    },
    "email_account": {
      "family": "crm",
      "canonical_path": "integrations/accounts/<id>.md",
      "append_only": false,
      "portability": "tenant_private",
      "required_fields": [
        "type",
        "id",
        "email",
        "label",
        "provider",
        "created_at"
      ]
    },
    "contact_attachment": {
      "family": "crm",
      "canonical_path": "files/attachments/<id>.md",
      "append_only": false,
      "portability": "tenant_private",
      "required_fields": [
        "type",
        "id",
        "contact_id",
        "file_id",
        "filename",
        "title",
        "attached_at"
      ]
    },
    "setting": {
      "family": "crm",
      "canonical_path": "settings/<key>.md",
      "append_only": false,
      "portability": "tenant_private",
      "required_fields": [
        "type",
        "key",
        "value",
        "created_at",
        "updated_at"
      ],
      "patterns": {
        "key": "^[a-z][a-z0-9_]{1,60}$"
      }
    },
    "user_profile": {
      "family": "crm",
      "canonical_path": "users/<profile_id>.md",
      "append_only": false,
      "portability": "tenant_private",
      "required_fields": [
        "type",
        "profile_id",
        "email",
        "created_at",
        "updated_at"
      ],
      "patterns": {
        "profile_id": "^user-[a-f0-9]{24}$"
      },
      "description": "Authenticated CRM user profile. Details are incrementally completed by the rep; when present, the saved address is the sole source for account proximity ranking."
    },
    "user_preferences": {
      "family": "crm",
      "canonical_path": "users/preferences/<profile_id>.md",
      "append_only": false,
      "portability": "tenant_private",
      "required_fields": [
        "type",
        "profile_id",
        "version",
        "work",
        "selling",
        "communication",
        "ai",
        "notifications",
        "market_intel",
        "assistant",
        "updated_at"
      ],
      "patterns": {
        "profile_id": "^user-[a-f0-9]{24}$"
      },
      "description": "Per-rep working preferences, selling parameters, communication tone, AI model choices and automation guardrails."
    },
    "user_connection": {
      "family": "crm",
      "canonical_path": "integrations/users/<profile_id>/<provider>.md",
      "append_only": false,
      "portability": "tenant_private",
      "required_fields": [
        "type",
        "profile_id",
        "provider",
        "status",
        "credential_ref",
        "capabilities",
        "monthly_budget_usd",
        "spent_this_month_usd"
      ],
      "required_when": {
        "status==verified": [
          "last_verified_at"
        ]
      },
      "enums": {
        "provider": [
          "openrouter",
          "openai",
          "anthropic",
          "claude",
          "gemini",
          "meta",
          "x_api",
          "social_provider",
          "gmail"
        ],
        "status": [
          "not_connected",
          "configured",
          "verified",
          "error"
        ]
      },
      "patterns": {
        "profile_id": "^user-[a-f0-9]{24}$"
      },
      "description": "Per-rep third-party integration connection metadata and budget guardrails. Secret values are stored exclusively in the machine's Total Recall secrets store."
    },
    "auth_credentials": {
      "family": "resource",
      "canonical_path": "auth/credentials.md",
      "append_only": false,
      "portability": "tenant_private",
      "required_fields": [
