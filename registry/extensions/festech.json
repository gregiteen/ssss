{
  "$schema": "https://ssss.dev/registry/v1",
  "conformance": "A festech-conformant host MUST resolve portability for these primitives from this registry. The `resource_bound` primitives MUST ship only a requirement declaration (never the seller's bound value) in a template/sale export; the `tenant_private` primitives MUST be dropped from template/sale entirely (\u00a75.5).",
  "description": "Festech extension registry. Defines the host-specific primitives that festech.live layers on top of the SSSS core (registry/core.json). Lifted from festech's docs/ssss/primitive-registry.json and assigned a portability class (\u00a75.5) so a festech workspace can be exported as a backup/template/sale bundle. Core primitives (assistant, workflow, rule, security_role, skill, model, memory, task, conversation, run, conflict, page, migration, release) are NOT redefined here \u2014 they are governed by core.json. An extension MUST NOT redefine a core type. Derived from the Festech application registry (docs/ssss/primitive-registry.json, 198 primitives); the 73 types observed in live vault data are declared here.",
  "document_primitives": {
    "ai_integration": {
      "append_only": false,
      "canonical_path": "integrations/ai.md",
      "family": "record",
      "portability": "tenant_private",
      "projection_strategy": "replace",
      "required_fields": [
        "type",
        "use_platform_tokens"
      ]
    },
    "asset_share": {
      "append_only": false,
      "canonical_path": "asset_shares/<id>.md",
      "family": "record",
      "notes": "A time-limited share link for a festech file asset. Holds a bearer token, so it never travels in a template/sale export.",
      "portability": "resource_bound",
      "required_fields": [
        "type",
        "id",
        "token",
        "asset_id"
      ]
    },
    "audit_log": {
