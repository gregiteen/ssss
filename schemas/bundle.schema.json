{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ssss.dev/schemas/bundle.schema.json",
  "title": "SSSS Universal Cloud Workspace (.ucw) Bundle Schema",
  "description": "JSON Schema for SSSS transport bundles and manifests (spec §16).",
  "type": "object",
  "required": [
    "manifest",
    "files"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "manifest": {
      "$ref": "#/$defs/bundleManifest"
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/bundleFile"
      }
    },
    "branding": {
      "type": "object"
    }
  },
  "$defs": {
    "bundleFile": {
      "type": "object",
      "required": [
        "path",
        "content"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "string"
        }
      }
    },
    "bundleManifest": {
      "type": "object",
      "required": [
        "name",
        "description",
        "version",
        "exported_at",
        "ssss_core_version",
        "required_extensions",
        "export_profile",
        "primitive_inventory",
        "provisioning",
        "file_count",
        "provenance"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "exported_at": {
          "type": "string",
          "minLength": 1
        },
        "ssss_core_version": {
          "type": "string",
          "minLength": 1
        },
        "required_extensions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "export_profile": {
          "type": "string",
          "enum": ["backup", "template", "sale"]
        },
        "primitive_inventory": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "primitives": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "extensions": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "migrations": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "integrity": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "content_hash": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "ssss_core_version": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "bundles": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "name": { "type": "string", "minLength": 1 },
                  "version": { "type": "string" },
                  "installMode": {
                    "type": "string",
                    "enum": ["optional", "recommended", "required"]
                  }
                }
              }
            }
          }
        },
        "provisioning": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provisioningStep"
          }
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provisioningParameter"
          }
        },
        "file_count": {
          "type": "integer",
          "minimum": 0
        },
        "provenance": {
          "type": "object",
          "required": [
            "content_hash",
            "exporter"
          ],
          "additionalProperties": false,
          "properties": {
            "content_hash": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "exporter": {
              "type": "string",
              "minLength": 1
            },
            "signature": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "source_workspace_id": {
          "type": "string",
          "minLength": 1
        },
        "branding": {
          "type": "object"
        }
      }
    },
    "provisioningStep": {
      "type": "object",
      "required": [
        "id",
        "label",
        "system",
        "mode",
        "required"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "system": {
          "type": "string",
          "enum": [
            "workspace",
            "branding",
            "email",
            "phone",
            "domains",
            "accounts",
            "deployments",
            "marketplace",
            "tabs",
            "automation"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "existing",
            "provision",
            "install",
            "generate",
            "configure"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "provisioningParameter": {
      "type": "object",
      "required": [
        "key",
        "label",
        "type",
        "scope",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "enum": ["user", "llm", "graph", "system"]
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "defaultValue": {},
        "options": {
          "type": "array"
        },
        "dependsOn": {
          "type": "string"
        }
      }
    }
  }
}
