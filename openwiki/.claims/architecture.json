    {
      "id": "claim_303ccd17b0ae421191b8863663bd1c9a",
      "statement": "The event log is the durable record of idempotency: every committed event carries its idempotency_key and request_hash written at the commit point, so the idempotency store is only a cache of full responses; a cache miss (retention, lost record, or new process) is resolved from the log by findByIdempotencyKey, and the FileIdempotencyStore retains entries 24 hours by default because a host whose event store answers key lookups may expire store records.",
      "evidence": [
        {
          "resource": "repo://docs/ssss-spec.md#L1081-L1117",
          "version": "repo-lines-v1:sha256:eaf205fe4d09fce88f3413638ac3faa08e548892207ed187359a2f5543e2ce75:"
