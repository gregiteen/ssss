    {
      "id": "claim_82c9a6fbaae74c1cb1280be7aadffe29",
      "statement": "Every failed kernel response carries exactly one symbolic error code from ERROR_CODES (invalid_request, unauthorized, forbidden, not_found, lease_conflict, version_conflict, idempotency_conflict, validation_failed, internal_error), and transports (src/http.mjs) map these codes to HTTP status without parsing messages; an absent or malformed principal yields unauthorized rather than forbidden.",
      "evidence": [
        {
          "resource": "repo://src/http.mjs#L3-L20",
