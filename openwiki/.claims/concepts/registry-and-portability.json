    {
      "id": "claim_d31fd16a36f54da3bc8dad8f9121d39f",
      "statement": "validateReferenceConstraints uses a caller-provided resolver to check that registry-declared reference fields are safe vault-relative paths, exist (unless must_exist is false), satisfy allowed_types/disallowed_types via isSamePrimitiveType, satisfy allowed_portability, and match a hash_field binding when declared.",
