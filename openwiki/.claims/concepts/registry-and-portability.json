        }
      ]
    },
    {
      "id": "claim_0ad459e841324f68acb9838a2581177d",
      "statement": "validateBundle independently enforces the portability guarantee: for every resource_bound file in a template/sale bundle, each resource.binds field must equal REQUIREMENT or the bundle is rejected for leaking a seller-bound value, and any file whose resolved portability class is excluded by the profile is rejected.",
      "evidence": [
        {
          "resource": "repo://src/bundle.mjs#L373-L408",
          "version": "repo-lines-v1:sha256:3f918a712613e91ab6c0061bf5c383346290d264d2775129cb74f2fa3064bef2:"
