    },
    {
      "id": "claim_72cf18e1666348c993d81d948fd09429",
      "statement": "validateDataConstraints validates required fields (universal plus type required_fields, treating empty arrays as present), required_when conditional requirements keyed by field==value, enums, and u-flagged patterns, all read from the registry type definition.",
