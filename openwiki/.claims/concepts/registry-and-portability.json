    {
      "id": "claim_dbb7530c28cc485db36083424f9b1922",
      "statement": "At provision time, provisionBundle resolves each REQUIREMENT placeholder against caller parameters using well-known aliases (e.g. domain for domain.domain_name, phone for phone_number.phone_number) and replaces the value before commit; an unresolved required binding is a provision error.",
      "evidence": [
        {
          "resource": "repo://src/bundle.mjs#L59-L69",
          "version": "repo-lines-v1:sha256:a952cb6321fd17cf2f780d8b5eaaa130f7c216d8b7893f0263a410e67cd389fb:"
