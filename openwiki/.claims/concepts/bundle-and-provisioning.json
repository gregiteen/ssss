    {
      "id": "claim_4d5c77c0b6374cc5a06c66f3018a689b",
      "statement": "In a template or sale profile, a resource_bound file is reduced to a REQUIREMENT declaration: reduceResourceBoundFile reads the registry type's resource.binds list, rewrites each bound field to the literal REQUIREMENT, tags the file x_portability: resource_bound, and strips the seller's bound value; validateBundle rejects a template/sale bundle that leaks a resource_bound field whose value is not REQUIREMENT.",
      "evidence": [
        {
          "resource": "repo://src/bundle.mjs#L104-L113",
          "version": "repo-lines-v1:sha256:1181322b220e77a0fd13737ae633008381abf68b0af1840fd13b44de63c82940:"
