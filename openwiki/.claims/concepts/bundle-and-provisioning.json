    {
      "id": "claim_7ba6dff885464eb48c01171de908fd2e",
      "statement": "importBundle is a two-phase replay: it rejects a plan that mixes dry_run and commit envelopes, preflights every envelope with engine.processOperation under dry_run true using in-plan references before the first real commit, and only commits if every preflight succeeds — so a late schema, reference, or authorization failure cannot leave a partial installation; a dry_run import validates and reports wouldCommit instead of committing, and a second import of the same plan is a no-op.",
      "evidence": [
        {
          "resource": "repo://docs/help/import.md#L1-L21",
          "version": "repo-lines-v1:sha256:aa77c5b6663de5d9d0ed88961dc1737d9f72f6eeb229fe7d1454c7a59a1764cf:"
