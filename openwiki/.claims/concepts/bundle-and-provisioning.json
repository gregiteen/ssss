    {
      "id": "claim_c9a5d0858d1c449ebdd38eb384818b9b",
      "statement": "The three provisioning verbs are export (pure: vault+profile -> byte-identical content-hashed bundle), provision (bundle+params -> ordered Operation Contract envelopes, touches no filesystem), and import (plan+engine -> committed state, idempotent); they compose as export then provision then import, or import runs provision inline from a bundle.",
      "evidence": [
        {
          "resource": "repo://docs/help/import.md#L1-L16",
          "version": "repo-lines-v1:sha256:a359b8b922b3f80e054c2337deb065b7435a99faf56b4fe953da5e120319dcff:"
