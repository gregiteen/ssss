  "claims": [
    {
      "id": "claim_b436de45fe7f4521bd52cf7a8724361e",
      "statement": "A .ucw bundle is JSON with required `manifest` and `files`; manifest-required fields (name, description, version, exported_at, ssss_core_version, required_extensions, export_profile, primitive_inventory, provisioning, file_count, provenance) are fixed by the registry `bundle` contract, and each files[] entry is exactly { path, content }; primitive_inventory counts every file by its registry type rather than a closed enum.",
      "evidence": [
        {
          "resource": "repo://registry/core.json#L283-L300",
          "version": "repo-lines-v1:sha256:168179a936275f1bd20968ecbb1688617b91b5116448290032bf9b023ad34ad0:"
        },
        {
